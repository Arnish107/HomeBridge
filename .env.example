# Firebase web config (Firebase console -> Project settings -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# Public site address, used in flyer QR codes (e.g. https://homebridge.vercel.app)
NEXT_PUBLIC_SITE_URL=

# ---- Local only: used by `npm run setup`, never needed on Vercel ----
# Firebase Auth user that receives the server-set admin role (custom claim)
ADMIN_EMAIL=
# Firebase Auth user that owns the Sunshine Home demo listing
DEMO_HOME_EMAIL=
# Service account key (Project settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
