# Firebase web config (Firebase console -> Project settings -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Email allowed into /admin
NEXT_PUBLIC_ADMIN_EMAIL=

# Public site address, used in flyer QR codes (e.g. https://homebridge.vercel.app)
NEXT_PUBLIC_SITE_URL=

# ---- Local only: used by `npm run setup`, never needed on Vercel ----
# Login you created in Firebase Console > Authentication for the Sunshine Home demo
DEMO_HOME_EMAIL=
# Service account key (Project settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
